{
  "name": "squashbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "vitest run",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute squashbot-eu --remote --file=schema.sql",
    "db:migrate:002": "wrangler d1 execute squashbot-eu --remote --file=migrations/002-players-and-tab.sql",
    "db:migrate:003": "wrangler d1 execute squashbot-eu --remote --file=migrations/003-per-player-reminders.sql",
    "db:migrate:004": "wrangler d1 execute squashbot-eu --remote --file=migrations/004-reminder-cleanup.sql",
    "db:migrate:005": "wrangler d1 execute squashbot-eu --remote --file=migrations/005-board-day-and-monthly-notices.sql",
    "db:migrate:006": "wrangler d1 execute squashbot-eu --remote --file=migrations/006-plus-ones.sql",
    "db:migrate:007": "wrangler d1 execute squashbot-eu --remote --file=migrations/007-monthly-notice-deliveries.sql",
    "db:migrate:008": "wrangler d1 execute squashbot-eu --remote --file=migrations/008-booking-delete-trigger.sql",
    "db:migrate:009": "wrangler d1 execute squashbot-eu --remote --file=migrations/009-pending-refreshes.sql",
    "db:migrate:010": "wrangler d1 execute squashbot-eu --remote --file=migrations/010-booking-announcements.sql",
    "db:migrate:011": "wrangler d1 execute squashbot-eu --remote --file=migrations/011-booking-followups.sql",
    "db:migrate:012": "wrangler d1 execute squashbot-eu --remote --file=migrations/012-maintenance-schedule.sql",
    "db:migrate:013": "wrangler d1 execute squashbot-eu --remote --file=migrations/013-ledger-identities.sql",
    "db:migrate:014": "wrangler d1 execute squashbot-eu --remote --file=migrations/014-availability-notices.sql",
    "db:migrate:015": "wrangler d1 execute squashbot-eu --remote --file=migrations/015-processed-updates.sql",
    "db:verify": "wrangler d1 execute squashbot-eu --remote --command=\"SELECT (SELECT count(tab_message_id) + count(board_day) + count(nudged_month) FROM settings) + (SELECT count(capacity) + count(charged) FROM bookings) + (SELECT count(reminder_sent) + count(pre_reminder_sent) + count(heads) FROM booking_players) + (SELECT count(status) + count(last_attempt_at) FROM monthly_notice_deliveries) + (SELECT count(board) + count(tab) FROM pending_refreshes) + (SELECT count(booking_id) + count(message_id) + count(lease_until) FROM availability_notices) + (SELECT count(next_due) + count(revision) FROM maintenance_schedule) + (SELECT count(user_id) FROM ledger_identity_aliases) + (SELECT count(seen_at) FROM processed_updates) AS schema_ok\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "wrangler": "^4.28.1"
  }
}
